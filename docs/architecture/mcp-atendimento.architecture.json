  "edges": [
    { "from": "client", "to": "gate", "label": "pedido autenticado" },
    { "from": "gate", "to": "context", "label": "consulta permitida" },
    { "from": "context", "to": "client", "label": "resumo, evidências e próximo passo" },
    { "from": "gate", "to": "approval", "label": "ação ou consumo de IA" },
    { "from": "approval", "to": "draft", "label": "gerar após aprovação" },
    { "from": "approval", "to": "operations", "label": "claim único após aprovação" },
    { "from": "draft", "to": "screens", "label": "editar, recusar ou aprovar no Inbox" },
    { "from": "operations", "to": "screens", "label": "resultado nas telas e timeline" },
